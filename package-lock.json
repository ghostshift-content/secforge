{
  "name": "secforge",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "secforge",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/cli": {
      "name": "@secforge/cli",
      "version": "0.0.0",
      "dependencies": {
        "@secforge/map": "*",
        "@secforge/session": "*",
        "@secforge/store": "*"
      },
      "bin": {
        "secforge": "bin/secforge.js"
      }
    },
    "apps/server": {
      "name": "@secforge/server",
      "version": "0.0.0",
      "dependencies": {
        "@secforge/schemas": "*",
        "@secforge/session": "*",
        "@secforge/store": "*"
      }
    },
    "node_modules/@secforge/adapters": {
      "resolved": "packages/adapters",
      "link": true
    },
    "node_modules/@secforge/agents": {
      "resolved": "packages/agents",
      "link": true
    },
    "node_modules/@secforge/assess": {
      "resolved": "packages/assess",
      "link": true
    },
    "node_modules/@secforge/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@secforge/env": {
      "resolved": "packages/env",
      "link": true
    },
    "node_modules/@secforge/map": {
      "resolved": "packages/map",
      "link": true
    },
    "node_modules/@secforge/memory": {
      "resolved": "packages/memory",
      "link": true
    },
    "node_modules/@secforge/orchestrator": {
      "resolved": "packages/orchestrator",
      "link": true
    },
    "node_modules/@secforge/patterns": {
      "resolved": "packages/patterns",
      "link": true
    },
    "node_modules/@secforge/schemas": {
      "resolved": "packages/schemas",
      "link": true
    },
    "node_modules/@secforge/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@secforge/session": {
      "resolved": "packages/session",
      "link": true
    },
    "node_modules/@secforge/store": {
      "resolved": "packages/store",
      "link": true
    },
    "packages/adapters": {
      "name": "@secforge/adapters",
      "version": "0.0.0"
    },
    "packages/agents": {
      "name": "@secforge/agents",
      "version": "0.0.0"
    },
    "packages/assess": {
      "name": "@secforge/assess",
      "version": "0.0.0"
    },
    "packages/env": {
      "name": "@secforge/env",
      "version": "0.0.0"
    },
    "packages/map": {
      "name": "@secforge/map",
      "version": "0.0.0"
    },
    "packages/memory": {
      "name": "@secforge/memory",
      "version": "0.0.0"
    },
    "packages/orchestrator": {
      "name": "@secforge/orchestrator",
      "version": "0.0.0"
    },
    "packages/patterns": {
      "name": "@secforge/patterns",
      "version": "0.0.0"
    },
    "packages/schemas": {
      "name": "@secforge/schemas",
      "version": "0.0.0"
    },
    "packages/session": {
      "name": "@secforge/session",
      "version": "0.0.0"
    },
    "packages/store": {
      "name": "@secforge/store",
      "version": "0.0.0"
    }
  }
}
